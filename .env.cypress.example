# Cypress server-backed auth/role e2e
CYPRESS_ENABLE_SERVER_E2E=1
CYPRESS_API_BASE_URL=http://127.0.0.1:4000/api/v1

# Admin account
CYPRESS_CMS_ADMIN_EMAIL=admin@example.com
CYPRESS_CMS_ADMIN_PASSWORD=ChangeMeAdmin@123

# Editor account
CYPRESS_CMS_EDITOR_EMAIL=editor@example.com
CYPRESS_CMS_EDITOR_PASSWORD=ChangeMeEditor@123

# Reviewer account
CYPRESS_CMS_REVIEWER_EMAIL=reviewer@example.com
CYPRESS_CMS_REVIEWER_PASSWORD=ChangeMeReviewer@123

# Local fcc-cms-server runtime options for one-command full run
TOKENSECRET=local-e2e-secret
ENABLE_SCHEDULER=false
